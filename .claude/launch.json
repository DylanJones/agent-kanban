{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent-kanban",
      "runtimeExecutable": "./target/release/agent-kanban",
      "runtimeArgs": [
        "serve",
        "--bind",
        "0.0.0.0:7878"
      ],
      "port": 7878
    },
    {
      "name": "api",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--quiet",
        "--",
        "serve",
        "--bind",
        "127.0.0.1:7878",
        "--no-auth"
      ],
      "env": {
        "AKB_DATA_DIR": ".dev-data"
      },
      "port": 7878
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
