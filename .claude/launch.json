{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--quiet", "--", "serve", "--bind", "127.0.0.1:7878", "--no-auth"],
      "env": { "AKB_DATA_DIR": ".dev-data" },
      "port": 7878
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
